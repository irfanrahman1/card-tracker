# Copy to .env if you want to override defaults. Never commit .env.
# Path to the SQLite database file (relative to backend/).
DATABASE_URL=sqlite:///./card_tracker.db
# Other web addresses allowed to send changes to the API (comma-separated).
# The app's own address is always allowed.
ALLOWED_ORIGINS=http://localhost:5173
# true when served over HTTPS (production), so login cookies are never sent unencrypted.
COOKIE_SECURE=false
# Proxies in front of the app (1 on Cloud Run, Koyeb, Render). 0 when run directly.
TRUSTED_PROXY_HOPS=0
