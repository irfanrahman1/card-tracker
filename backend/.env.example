# Copy to .env if you want to override defaults. Never commit .env.
# Path to the SQLite database file (relative to backend/).
DATABASE_URL=sqlite:///./card_tracker.db
# Other web addresses allowed to send changes to the API (comma-separated).
# The app's own address is always allowed.
ALLOWED_ORIGINS=http://localhost:5173
# true when served over HTTPS (production), so login cookies are never sent unencrypted.
COOKIE_SECURE=false
# Proxies in front of the app (1 on Vercel, Cloud Run, Render). 0 when run directly.
TRUSTED_PROXY_HOPS=0
# Where emailed links point (your site's address).
APP_URL=http://localhost:5173
# Email for password resets (optional locally: links are printed in the terminal).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=Card Tracker <you@gmail.com>
